# Copia este archivo como .env.local. Todo es opcional en local.

# URL pública de la app (se usa para armar los enlaces cortos y el QR).
# NEXT_PUBLIC_APP_URL=https://snip.to

# Sal para el hash de IP (cámbiala en producción).
IP_HASH_SALT=cambia-esto-por-un-valor-largo-y-aleatorio

# Archivo SQLite (por defecto ./data/snip.db)
# DATABASE_FILE=./data/snip.db

# Iniciar sesión con proveedores (cada botón aparece solo si están sus variables).
# Redirect URI de cada uno: <APP_URL>/api/auth/<google|github|apple>/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# APPLE_CLIENT_ID=        (Services ID, p. ej. to.snip.web)
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY=      (contenido del .p8, con 
 en lugar de saltos de línea)

# Correo para los códigos (dispositivo nuevo y borrar cuenta). Usa UNA opción.
# Sin correo configurado, en producción no se pide código (para no dejar a nadie fuera).
# RESEND_API_KEY=
# MAIL_FROM="Snip <hola@tudominio.com>"
# SMTP_URL=smtps://tucorreo%40gmail.com:CONTRASENA_DE_APLICACION@smtp.gmail.com:465

# Caché de redirección y límite de uso con Upstash Redis (si faltan, se usa memoria).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Google Safe Browsing (si falta, no se verifica el destino).
# GOOGLE_SAFE_BROWSING_KEY=
